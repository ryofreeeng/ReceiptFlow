# .envのテンプレート。実際の値を入れて .env にコピーして使う
#
# Google Drive のフォルダIDの調べ方：
#   Driveでフォルダを開いたときのURLの末尾の文字列がフォルダID
#   例: https://drive.google.com/drive/folders/★ここがフォルダID★

# 未処理PDFを置くGoogle DriveフォルダのID（未処理フォルダ）
UNPROCESSED_FOLDER_ID=your_unprocessed_folder_id_here

# 処理済みPDFの移動先Google DriveフォルダのID（処理済みフォルダ）
# Driveに "processed" フォルダを作成してそのIDを貼り付ける
PROCESSED_FOLDER_ID=your_processed_folder_id_here

# 日付リネーム済みPDFのアップロード先Google DriveフォルダのID（リネームフォルダ）
# Driveに "renamed" フォルダを作成してそのIDを貼り付ける
RENAMED_FOLDER_ID=your_renamed_folder_id_here
